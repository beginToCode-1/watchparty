{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalEnv": [
    "NEXT_PUBLIC_SERVER_URL",
    "NEXT_PUBLIC_EXTENSION_ID",
    "VITE_SERVER_URL",
    "VITE_WEB_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
