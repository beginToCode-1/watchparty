# Root .env — read by `docker compose` for variable substitution (copy to .env, never commit it).
# Local dev without Docker uses apps/server/.env, apps/web/.env.local and apps/extension/.env instead.

# --- server (contract env) ---
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
EXTENSION_IDS=
# Compose builds REDIS_URL itself (redis://:${REDIS_PASSWORD}@redis:6379). Outside compose: unset => in-memory store.
# REDIS_URL=redis://localhost:6379
TURN_SECRET=change-me-to-64-hex-chars-openssl-rand-hex-32
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
STUN_URLS=stun:stun.l.google.com:19302
ROOM_TTL_SECONDS=86400
LOG_LEVEL=info
# IPs/CIDRs whose X-Forwarded-For is believed (your nginx). Server default: loopback only; compose adds 172.30.0.0/24.
# TRUSTED_PROXIES=127.0.0.1/8,::1/128

# --- compose-level ---
# Hex only (openssl rand -hex 32): REDIS_PASSWORD goes into a URL, TURN_SECRET through sed.
REDIS_PASSWORD=change-me-to-64-hex-chars-openssl-rand-hex-32
# Public IP coturn advertises; "public/private" form when coturn runs behind Docker NAT.
TURN_EXTERNAL_IP=127.0.0.1

# --- web (build args, inlined at `next build`) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_EXTENSION_ID=

# --- extension (apps/extension/.env, inlined at `vite build`) ---
VITE_SERVER_URL=http://localhost:4000
VITE_WEB_URL=http://localhost:3000
