# Copy to apps/server/.env for local dev (loaded by src/env.ts via process.loadEnvFile). Never commit .env.
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
# Comma-separated Chrome extension ids, allowed as chrome-extension://<id> on the HTTP routes.
EXTENSION_IDS=
# Unset => in-memory store (single instance). With Redis: redis://localhost:6379
REDIS_URL=
# Empty => /api/turn returns STUN only (fine on localhost/LAN). Must equal coturn's static-auth-secret.
TURN_SECRET=
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
STUN_URLS=stun:stun.l.google.com:19302
ROOM_TTL_SECONDS=86400
LOG_LEVEL=info
