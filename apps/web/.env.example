# Copy to apps/web/.env.local. NEXT_PUBLIC_* values are inlined at build time: rebuild after changing them.
# Empty = same origin: the server proxies this app (WEB_UPSTREAM), e.g. one Cloudflare tunnel -> :4000, and the page's
# own origin is used at runtime. Only for `next dev` on :3000 with the server on :4000, put
# NEXT_PUBLIC_SERVER_URL=http://localhost:4000 in apps/web/.env.development.local (`next build` never reads that file).
NEXT_PUBLIC_SERVER_URL=
# Chrome extension id. Empty => the id pinned by the extension's manifest `key` (kgeaggokfampiakpipghoaeockijhbai).
NEXT_PUBLIC_EXTENSION_ID=
